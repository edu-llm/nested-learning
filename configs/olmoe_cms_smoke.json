{
  "run": {
    "output_dir": "results/olmoe_cms_smoke",
    "seed": 17,
    "log_every": 5,
    "eval_every": 20
  },
  "model": {
    "name": "allenai/OLMoE-1B-7B-0125",
    "attn_implementation": "sdpa"
  },
  "adapter": {
    "mode": "cms",
    "target_pattern": "^model\\.layers\\.\\d+\\.mlp$",
    "first_layer": 10,
    "last_layer": null,
    "rank": 64,
    "chunk_sizes": [64, 256, 1024],
    "learning_rates": [0.30, 0.12, 0.035],
    "dropout": 0.0,
    "output_scale": 0.05,
    "memory_update_rule": "delta",
    "retention_factor": 0.995,
    "update_momentum": 0.5,
    "self_reference_scale": 0.1,
    "detach_memory_updates": true,
    "aux_loss_weight": 0.05
  },
  "data": {
    "seed": 1000,
    "eval_seed": 900000,
    "train_size": 2000,
    "eval_size": 64,
    "max_length": 2048,
    "num_facts": 32,
    "train_suites": ["facts", "needle", "language"],
    "include_needle_eval": true,
    "include_language_eval": true,
    "include_guardrail_ppl": true
  },
  "train": {
    "optimizer": "adamw",
    "train_base": false,
    "per_device_batch_size": 1,
    "gradient_accumulation_steps": 4,
    "max_steps": 100,
    "learning_rate": 0.0002,
    "warmup_steps": 10,
    "weight_decay": 0.01,
    "betas": [0.9, 0.95],
    "max_grad_norm": 1.0,
    "mixed_precision": "bf16",
    "gradient_checkpointing": true,
    "num_workers": 2
  }
}
